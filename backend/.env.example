# Every gateway-owned environment variable is namespaced with `MG_` (MawiGateway).
# Copy to `.env` and fill in. Anything you don't override falls back to the
# documented default. Run `dotenv` is invoked at boot from `gateway::main`.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MG_DATABASE_URL=postgresql://mawi:CHANGE_ME_IN_PRODUCTION@localhost:5432/mawi

# Optional: load mawigateway.yaml at boot. The file is upserted into the same
# providers/models/services/service_models tables the API writes to, so YAML
# and runtime API edits coexist. See `mawigateway.example.yaml` at the repo
# root for a worked example.
# MG_CONFIG_FILE=/etc/mawigateway/mawigateway.yaml

# ---------------------------------------------------------------------------
# Security — REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
MG_MASTER_KEY=

# Emergency escape hatch for #32. Default `false`: rows whose api_key column
# was inserted plaintext are refused at decrypt time, and a startup migration
# re-encrypts them in place. Set `true` only if you need to bring up the
# gateway against an un-migrated DB; revert to `false` once
# `migrate_plaintext_keys` has run successfully.
MG_ALLOW_PLAINTEXT_KEYS=false

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
MG_PORT=8030

# tracing-subscriber EnvFilter syntax. Default `info,sqlx=warn,hyper=warn`.
MG_RUST_LOG=info

# `json` for structured logs; anything else (default) for human-readable.
# MG_LOG_FORMAT=json

# CORS — comma-separated origins. Empty/unset → all browser requests rejected
# (fail-secure). Set to a comma-separated list of trusted origins for prod.
MG_CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Metrics — `/metrics` endpoint mounted by default. Set MG_DISABLE_METRICS=true
# to suppress (e.g. behind an unauthenticated edge). Legacy
# MG_ENABLE_METRICS=false also honoured.
MG_ENABLE_METRICS=true

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
# Reserve a slice of the model's context window for its own response. The
# lesser of TOKENS (absolute cap) and RATIO×window applies. Defaults: 2048
# tokens / 20% of window. Lift TOKENS for code-gen workloads where outputs
# run long; lower RATIO for chat where the response is usually a sentence.
# MG_CONTEXT_OUTPUT_RESERVATION_TOKENS=2048
# MG_CONTEXT_OUTPUT_RESERVATION_RATIO=0.2

# Graceful-shutdown grace window (seconds). After SIGINT/SIGTERM, the server
# stops accepting new requests and waits up to this long for in-flight ones
# to complete. Set high enough to cover your slowest expected provider call —
# Sora/Veo video generation routinely hits 60s+. Match your orchestrator's
# terminationGracePeriodSeconds.
MG_SHUTDOWN_GRACE_SECS=60

# TTL for in-process metadata caches (models, providers, services,
# service_models). Default 60s. Lengthen this when high concurrent traffic
# causes DB thrash on simultaneous cache expiry — rule of thumb: at least
# 2× your cache-miss latency to amortise the DB load.
# MG_CACHE_TTL_SECS=60

# Per-user request rate limit (requests per minute per authenticated user).
# Fixed 60-second window, in-memory per pod by default. Default: 60.
MG_DEFAULT_RATE_LIMIT_PER_MIN=60

# Optional: switch the rate limiter to Redis for multi-pod deployments.
# MG_RATE_LIMIT_REDIS_URL=redis://localhost:6379

# Idempotency-Key cache TTL (seconds). Default 86400 (24h, matches Stripe).
# Clients send `Idempotency-Key: <8..256 chars>` on POSTs to make retries
# safe — a network blip during a paid inference call no longer double-bills.
# Honoured on every synchronous inference endpoint:
#   /v1/chat/completions (non-streaming), /v1/images/generations,
#   /v1/audio/speech, /v1/audio/transcriptions, /v1/audio/speech-to-speech.
# MG_IDEMPOTENCY_TTL_SECS=86400

# How often the background sweeper deletes expired idempotency rows.
# Default 1 hour. Lower for shorter retention or low-throughput deployments;
# raise for very high throughput where the cleanup query starts to compete
# with hot-path traffic.
# MG_IDEMPOTENCY_CLEANUP_INTERVAL_SECS=3600

# ---------------------------------------------------------------------------
# Semantic cache (optional)
# ---------------------------------------------------------------------------
# Used to embed prompts for the semantic cache feature. Falls back to
# MG_OPENAI_API_KEY if the dedicated embedding key is unset.
# MG_EMBEDDING_API_KEY=
# MG_EMBEDDING_API_BASE=https://api.openai.com/v1
# MG_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Provider API Keys (optional)
#
# Convenience for self-hosters: any provider whose `api_key` column is empty
# in the providers table will fall back to the matching env var below at
# request time. Values here are PLAINTEXT — the master-key encryption only
# applies to keys stored in the database (admin UI / API). Admin-UI-managed
# keys still take precedence; env vars only fill in when the DB column is
# blank.
#
# Leave any line you don't use commented out — an empty value falls through
# the same as if the variable were unset.
# ---------------------------------------------------------------------------

# Text + chat
# MG_OPENAI_API_KEY=
# MG_ANTHROPIC_API_KEY=
# MG_GEMINI_API_KEY=
# MG_AZURE_OPENAI_API_KEY=
# MG_XAI_API_KEY=
# MG_MISTRAL_API_KEY=
# MG_PERPLEXITY_API_KEY=
# MG_DEEPSEEK_API_KEY=

# Audio (TTS / STT / speech-to-speech)
# MG_ELEVENLABS_API_KEY=
# MG_HUME_API_KEY=

# Image + video
# MG_RUNWAY_API_KEY=
# MG_KLING_API_KEY=          # Kuaishou Kling — pre-signed JWT bearer
# MG_LUMA_API_KEY=           # Luma AI Dream Machine
# MG_PIKA_API_KEY=           # Pika Labs
# MG_MINIMAX_API_KEY=        # MiniMax Hailuo (video) + Abab (chat)
# MG_BYTEDANCE_API_KEY=      # ByteDance Seedance (Volcano Ark)
