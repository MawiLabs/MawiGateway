# Database Configuration
DATABASE_URL=postgresql://mawi:CHANGE_ME_IN_PRODUCTION@localhost:5432/mawi

# Security - REQUIRED IN PRODUCTION
# Generate with: openssl rand -hex 32
MAWI_MASTER_KEY=

# Server Configuration
PORT=8030
RUST_LOG=info

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Optional: Metrics
ENABLE_METRICS=true

# Graceful-shutdown grace window (seconds). After SIGINT/SIGTERM, the
# server stops accepting new requests and waits up to this long for
# in-flight ones to complete. Set high enough to cover your slowest
# expected provider call — Sora/Veo video generation routinely hits
# 60s+. Match your orchestrator's terminationGracePeriodSeconds.
SHUTDOWN_GRACE_SECS=60
