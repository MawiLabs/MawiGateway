# Database Configuration
DATABASE_URL=postgresql://mawi:CHANGE_ME_IN_PRODUCTION@localhost:5432/mawi

# Security - REQUIRED IN PRODUCTION
# Generate with: openssl rand -hex 32
MAWI_MASTER_KEY=

# Server Configuration
PORT=8030
RUST_LOG=info

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Optional: Metrics
ENABLE_METRICS=true

# Idempotency-Key cache TTL (seconds). Default 86400 (24h, matches Stripe).
# Clients send `Idempotency-Key: <8..256 chars>` on POSTs to make retries
# safe — a network blip during a paid inference call no longer double-bills.
# Currently honoured on /v1/chat/completions (non-streaming); other
# inference endpoints land in a follow-up PR.
# IDEMPOTENCY_TTL_SECS=86400
