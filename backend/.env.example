# Database Configuration
DATABASE_URL=postgresql://mawi:CHANGE_ME_IN_PRODUCTION@localhost:5432/mawi

# Security - REQUIRED IN PRODUCTION
# Generate with: openssl rand -hex 32
MAWI_MASTER_KEY=

# Server Configuration
PORT=8030
RUST_LOG=info

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Optional: Metrics
ENABLE_METRICS=true

# Idempotency-Key cache TTL (seconds). Default 86400 (24h, matches Stripe).
# Clients send `Idempotency-Key: <8..256 chars>` on POSTs to make retries
# safe — a network blip during a paid inference call no longer double-bills.
# Honoured on every synchronous inference endpoint:
#   /v1/chat/completions (non-streaming), /v1/images/generations,
#   /v1/audio/speech, /v1/audio/transcriptions, /v1/audio/speech-to-speech.
# IDEMPOTENCY_TTL_SECS=86400

# How often the background sweeper deletes expired idempotency rows.
# Default 1 hour. Lower for shorter retention or low-throughput
# deployments; raise for very high throughput where the cleanup
# query starts to compete with hot-path traffic.
# IDEMPOTENCY_CLEANUP_INTERVAL_SECS=3600
