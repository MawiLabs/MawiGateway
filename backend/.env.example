# Database Configuration
DATABASE_URL=postgresql://mawi:CHANGE_ME_IN_PRODUCTION@localhost:5432/mawi

# Optional: load mawigateway.yaml at boot. The file is upserted into
# the same providers/models/services/service_models tables the API
# writes to, so YAML and runtime API edits coexist. See
# `mawigateway.example.yaml` at the repo root for a worked example.
# MAWI_CONFIG_FILE=/etc/mawigateway/mawigateway.yaml

# Security - REQUIRED IN PRODUCTION
# Generate with: openssl rand -hex 32
MAWI_MASTER_KEY=

# Server Configuration
PORT=8030
RUST_LOG=info

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Optional: Metrics
ENABLE_METRICS=true
