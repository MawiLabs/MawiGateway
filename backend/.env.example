# Database Configuration
DATABASE_URL=postgresql://mawi:CHANGE_ME_IN_PRODUCTION@localhost:5432/mawi

# Security - REQUIRED IN PRODUCTION
# Generate with: openssl rand -hex 32
MAWI_MASTER_KEY=

# Emergency escape hatch for #32. Default `false`: rows whose api_key column
# was inserted plaintext are refused at decrypt time, and a startup migration
# re-encrypts them in place. Set `true` only if you need to bring up the
# gateway against an un-migrated DB; revert to `false` once
# `migrate_plaintext_keys` has run successfully.
MAWI_ALLOW_PLAINTEXT_KEYS=false

# Server Configuration
PORT=8030
RUST_LOG=info

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Optional: Metrics
ENABLE_METRICS=true
